rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() { return request.auth != null; }
    function isPlatformAdmin() { return signedIn() && request.auth.token.email == "vaddever@gmail.com"; }
    // Owner: an account's first business uses the account uid as its id;
    // further businesses are registered in biz_index/{bizId} with ownerUid.
    function ownsBiz(bizId) {
      return signedIn() && (request.auth.uid == bizId
        || (exists(/databases/$(database)/documents/biz_index/$(bizId))
            && get(/databases/$(database)/documents/biz_index/$(bizId)).data.ownerUid == request.auth.uid));
    }
    // Team member: members/{bizId}_{memberUid}  (older format: members/{memberUid} with ownerUid)
    function isTeam(bizId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/members/$(bizId + '_' + request.auth.uid))
        || (exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.ownerUid == bizId));
    }
    function canUseBiz(bizId) { return ownsBiz(bizId) || isTeam(bizId); }
    // Team member invited with the "Admin" role (can see salaries and payroll)
    function isTeamAdmin(bizId) {
      return signedIn() && (
        (exists(/databases/$(database)/documents/members/$(bizId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/members/$(bizId + '_' + request.auth.uid)).data.role == 'admin')
        || (exists(/databases/$(database)/documents/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.ownerUid == bizId
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin'));
    }
    function canSeePay(bizId) { return ownsBiz(bizId) || isTeamAdmin(bizId); }
    function inviteAllows(code, bizId, ownerUid) {
      let inv = get(/databases/$(database)/documents/invites/$(code)).data;
      return inv.status == 'pending'
        && inv.get('bizId', inv.ownerUid) == bizId
        && inv.ownerUid == ownerUid
        && (inv.email == '' || inv.email == request.auth.token.email.lower());
    }

    /* ---------- business data: owner + team members ---------- */
    match /businesses/{bizId} {
      allow read, update: if canUseBiz(bizId);
      allow create: if ownsBiz(bizId);
      allow delete: if ownsBiz(bizId) || isPlatformAdmin();

      // Customer orders: the business manages them; customers (not signed in) place and track them
      match /customerOrders/{orderId} {
        allow read, write: if canUseBiz(bizId);
        allow create: if request.auth == null;
        allow read:   if request.auth == null;
        allow update: if request.auth == null;
      }
      // Sales from the staff POS link: staff devices can only ADD a sale, and only with the secret POS token
      match /posQueue/{saleId} {
        allow read, delete: if canUseBiz(bizId);
        allow create: if request.resource.data.keys().hasOnly(['posToken', 'txn', 'clock', 'createdAt'])
          && (('txn' in request.resource.data) || ('clock' in request.resource.data))
          && request.resource.data.posToken is string
          && exists(/databases/$(database)/documents/pos_portals/$(request.resource.data.posToken))
          && get(/databases/$(database)/documents/pos_portals/$(request.resource.data.posToken)).data.businessUid == bizId;
      }
    }

    /* ---------- staff: attendance (all business users) · pay & payroll (owner + team admins) ---------- */
    match /businesses/{bizId}/attendance/{month} {
      allow read, write: if canUseBiz(bizId);
    }
    match /businesses/{bizId}/hr/{doc} {
      allow read, write: if canSeePay(bizId);
    }
    match /businesses/{bizId}/payroll/{month} {
      allow read, write: if canSeePay(bizId);
    }

    /* ---------- business registry (which account owns which business) ---------- */
    match /biz_index/{bizId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isPlatformAdmin() || isTeam(bizId));
      // can only register an id that is your account id, or a business that does not exist yet
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && (bizId == request.auth.uid || !exists(/databases/$(database)/documents/businesses/$(bizId)));
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isPlatformAdmin());
    }

    /* ---------- public copies (readable only with the secret token; no listing) ---------- */
    match /portals/{token} {
      allow get: if true;
      allow create: if canUseBiz(request.resource.data.businessUid);
      allow update: if request.resource.data.businessUid == resource.data.businessUid && canUseBiz(resource.data.businessUid);
      allow delete: if canUseBiz(resource.data.businessUid);
    }
    match /pos_portals/{token} {
      allow get: if true;
      allow create: if canUseBiz(request.resource.data.businessUid);
      allow update: if request.resource.data.businessUid == resource.data.businessUid && canUseBiz(resource.data.businessUid);
      allow delete: if canUseBiz(resource.data.businessUid);
    }

    /* ---------- team invitations ---------- */
    match /invites/{code} {
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && ownsBiz(request.resource.data.get('bizId', request.auth.uid));
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || ( resource.data.status == 'pending'
             && request.resource.data.status == 'accepted'
             && request.resource.data.acceptedBy == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']) ) );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /members/{mid} {
      allow get: if signedIn() && (resource == null || resource.data.get('memberUid', mid) == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn() && (resource.data.memberUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      // created only from a valid, unused invite for that exact business
      allow create: if signedIn()
        && request.resource.data.memberUid == request.auth.uid
        && mid == request.resource.data.bizId + '_' + request.auth.uid
        && inviteAllows(request.resource.data.code, request.resource.data.bizId, request.resource.data.ownerUid);
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.get('memberUid', mid) == request.auth.uid);
    }

    /* ---------- Pro payments by bank transfer slip ---------- */
    match /pro_requests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['id', 'uid', 'email', 'businessName', 'months', 'amount', 'currency', 'slip', 'ref', 'status', 'createdAt']);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isPlatformAdmin());
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    /* ---------- accounts / subscriptions (plan_info/{accountUid}) ---------- */
    match /plan_info/{uid} {
      allow get: if signedIn();                 // team members need the owner's plan
      allow list: if isPlatformAdmin();
      // an account may only create its own record, as a free plan with no subscription / suspension fields
      allow create: if isPlatformAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.plan == 'free'
        && !request.resource.data.keys().hasAny(['proUntil', 'subscriptions', 'suspended']));
      allow update, delete: if isPlatformAdmin();   // only the platform admin changes plans
    }

    /* ---------- platform-wide settings ---------- */
    match /platform_config/{doc} {
      allow read:  if signedIn();
      allow write: if isPlatformAdmin();
    }
  }
}
